{
	"name": "querydon",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm --filter @querydon/shared build && pnpm -r --parallel dev",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:seed",
		"db:seed": "pnpm --filter @querydon/db seed",
		"db:logs": "docker compose logs -f postgres",
		"db:psql": "docker compose exec postgres psql -U querydon -d shop",
		"db:test": "docker compose exec -T postgres sh -s < db/tests/reader-permissions.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2"
	}
}
