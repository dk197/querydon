# Backend
PORT=3000

# LLM (openai-compatible | anthropic)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-14b-instruct
LLM_API_KEY=lm-studio

# Postgres container (docker-compose.yml)
POSTGRES_DB=shop
POSTGRES_USER=querydon
POSTGRES_PASSWORD=querydon
POSTGRES_PORT=5433
QUERYDON_READER_PASSWORD=querydon-reader

# Databases: built from the values above (the backend loads .env with variable expansion),
# so a password or port is changed in one place. Passwords used here must be URL-safe.
TARGET_DATABASE_URL=postgres://querydon_reader:${QUERYDON_READER_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
APP_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
