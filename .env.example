# Backend
PORT=3000

# LLM (openai-compatible | anthropic)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-14b-instruct
LLM_API_KEY=lm-studio

# Postgres container (docker-compose.yml)
POSTGRES_DB=shop
POSTGRES_USER=querydon
POSTGRES_PASSWORD=querydon
POSTGRES_PORT=5433

# Databases
TARGET_DATABASE_URL=postgres://querydon_reader:querydon-reader@localhost:5433/shop
APP_DATABASE_URL=postgres://querydon:querydon@localhost:5433/shop
