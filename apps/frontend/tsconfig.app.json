{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"verbatimModuleSyntax": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"types": ["vite/client"]
	},
	"include": ["src"]
}
